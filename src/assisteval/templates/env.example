# Bu dosyayı .env olarak kopyalayıp doldurun. .env repoya girmez.
# Değerler "Login to GetStarted" Postman collection'ındaki değişkenlerle aynıdır.

# Test müşterisi
CUSTOMER_ID=96014828
GSM_NUMBER=
PASSWORD=
OTP=121212

# Servis kullanıcısı (InitialLogin ve sonrası): ext_u_name / ext_u_password
EXT_U_NAME=MobilePrivateTest
EXT_U_PASSWORD=

# Cihaz kaydı (LoginForMobileBranch): ExtUName / ExtUPassword / UserId
REG_EXT_U_NAME=MobilePublicTest
REG_EXT_U_PASSWORD=
REG_USER_ID=

# Groq API anahtarı (config.yaml'da provider: groq iken). Boş bırakırsanız çalışırken terminalden sorulur.
GROQ_API_KEY=

# Simülatör LLM'i için API anahtarı (doluysa GROQ_API_KEY'in önüne geçer; gerekmiyorsa boş bırakın)
LLM_API_KEY=

# Değerlendirme hakemi için API anahtarı (boşsa LLM_API_KEY kullanılır)
JUDGE_API_KEY=

# --- Ortam ayarları (boş bırakılırsa config.yaml'daki değer kullanılır) ---
# Asistan uç noktaları
ASSISTANT_BASE_URL=
CHATBOT_MESSAGE_URL=

# Simülatör LLM'i: LLM_PROVIDER=groq | openai (kurum içi Qwen için openai + LLM_BASE_URL)
LLM_PROVIDER=
LLM_BASE_URL=
LLM_MODEL=

# Değerlendirme hakemi (boşsa simülatör LLM'inin ayarları kullanılır)
JUDGE_PROVIDER=
JUDGE_BASE_URL=
JUDGE_MODEL=
